NODE_ENV=development
PORT=4000

# Supabase Postgres (Transaction pooler, port 6543). Same value as packages/db/.env
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Session cookie
COOKIE_NAME=portfolio_admin
# COOKIE_DOMAIN=.ignaciofigueroa.dev

# Allowed origins for CORS, comma separated
FRONTEND_URL=http://localhost:3000

# Supabase Storage (Project Settings -> API). The bucket must exist and be public.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=media

# GitHub, used to sync pull requests on contributions
GITHUB_TOKEN=""
GITHUB_USERNAME=figueroaignacio

# Assistant: Gemini for the chat, HuggingFace for the RAG embeddings
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash
HF_TOKEN=""
